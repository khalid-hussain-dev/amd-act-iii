# Copy to .env locally. Never commit real credentials.
# AMD Radeon Cloud's currently documented public Token Factory chat endpoint.
# Confirm the Base URL shown for your selected model before changing this value.
AMD_CHAT_COMPLETIONS_URL=https://developer.amd.com.cn/radeon/api/v1/chat/completions
# This endpoint's API model ID; the served weight release may have a version suffix.
AMD_MODEL_NAME=DeepSeek-V4-Flash
AMD_API_KEY=

